   "headword": "người ta",
   "base": "e9c6d43c51b49bee",
   "senses": [
    {
     "position": 1,
     "pos": "noun",
     "tags": [],
     "gloss": "people in general"
    },
    {
     "position": 2,
     "pos": "pron",
     "tags": [
      "colloquial"
     ],
     "gloss": "they/them, other people in general"
    },
    {
     "position": 3,
     "pos": "pron",
     "tags": [],
     "gloss": "he/him / she/her / they/them, that/those specific person/people, as opposed to me/us"
    },
    {
     "position": 4,
     "pos": "pron",
     "tags": [
      "familiar"
     ],
     "gloss": "I/me"
    }
   ],
   "examples": [
    {
     "sense": 1,
     "vi": "Trăm năm trong cõi người ta / Chữ tài chữ mệnh khéo là ghét nhau",
     "en": "Within the hundred years of human existence / Talent and destiny wage a bitter struggle"
    },
    {
     "sense": 2,
     "vi": "Con gái người ta vừa giỏi vừa đẹp, chẳng bù cho con nhà mình.",
     "en": "Other people's daughters are talented and beautiful. Alas, ours is anything but."
    },
    {
     "sense": 3,
     "vi": "Qua nhà người ta chè chén cả đêm không biết ngượng à ?",
     "en": "You stayed at their house partying all night. Have you no shame?"
    },
    {
     "sense": 3,
     "vi": "Anh đem đồ đạc này mau đưa cho người ta mang về đi.",
     "en": "Quickly bring the stuff back to him."
    },
    {
     "sense": 3,
     "vi": "Người ta có coi mình ra cái gì đâu!",
     "en": "They don't respect us at all!"
    },
    {
     "sense": 4,
     "vi": "Kệ người ta ! Người đâu mà vô duyên !",
     "en": "Nunya! You're so nosy, you know that?"
    },
    {
     "sense": 4,
     "vi": "Sao cứ chọc người ta hoài?",
     "en": "Why do you guys keep teasing me?"
    },
    {
     "sense": 4,
     "vi": "Anh ngốc quá à ! Người ta gợi ý đến thế mà còn không hiểu !",
     "en": "You dummy! You couldn't take a single hint I gave!"
    },
    {
     "sense": 4,
     "vi": "Đi đâu để người ta chờ mãi.",
     "en": "Where did you go? I've been waiting here forever."
    }
   ]
