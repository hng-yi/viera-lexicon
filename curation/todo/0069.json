   "senses": [
    {
     "position": 1,
     "pos": "verb",
     "tags": [
      "euphemistic",
      "literary"
     ],
     "gloss": "to rape"
    }
   ],
   "examples": [
    {
     "sense": 1,
     "vi": "Nếu một người đàn ông gặp một thiếu nữ còn trinh chưa hứa hôn với ai rồi cưỡng hiếp nàng và sau nầy bị khám phá, thì người đó phải trả cho cha cô gái bốn mươi lượng bạc. Người đó phải lấy cô gái vì đã làm nhục nàng, và suốt đời không được phép ly dị nàng.",
     "en": "If a man sees an unbetrothed virgin girl, rapes her and is found out later, he must pay her father forty taels of silver. He must marry her for he has degraded her, and he is never to divorce her for the rest of his life."
    }
   ]
