  {
   "headword": "hậu sự",
   "base": "ca27e9ec4b21c85c",
   "senses": [
    {
     "position": 1,
     "pos": "noun",
     "tags": [],
     "gloss": "the undertaking of tang (“funeral, burial/cremation and mourning”)"
