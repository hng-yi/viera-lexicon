  {
   "headword": "ba cái",
   "base": "7e26099a996d10e5",
   "senses": [
    {
     "position": 1,
     "pos": "phrase",
     "tags": [],
     "gloss": "Used other than figuratively or idiomatically: see ba, cái."
    },
    {
     "position": 2,
     "pos": "prefix",
     "tags": [
      "morpheme"
     ],
     "gloss": "all that/those; and stuff; and shit; or whatever (expressing uninterest, indifference or apathy about what is being mentioned)"
    }
   ],
   "examples": [
    {
     "sense": 2,
     "vi": "ba cái đồ nhôm nhựa",
     "en": "all that junk; junk and stuff; junk or whatever"
    },
    {
     "sense": 2,
     "vi": "Tao đéo cần biết ba cái đồ nữ trang của mày.",
     "en": "I don't give a fuck about your jewelry shit."
    },
    {
     "sense": 2,
     "vi": "ba cái chuyện vặt vãnh",
     "en": "all that frivolous stuff"
    },
    {
     "sense": 2,
     "vi": "ba cái trò con nít",
     "en": "all that child's play"
    },
    {
     "sense": 2,
     "vi": "Lớn rồi, đừng có chơi ba cái trò con nít nữa.",
     "en": "You're a grown-ass man, quit screwing around like a kid."
    },
    {
     "sense": 2,
     "vi": "Dẹp cha nó ba cái vụ Vũng Tàu với vũng ghe đi! Bộ thằng Hai Hùng để tao mặc quần đùi bộ đội xuống biển, xuống đến đâu sủi bong bóng ra đến đó hả. Dẹp! Cùng đi, cùng vô, cùng về.",
     "en": "To hell with all that Vũng Tàu shit! Does Hai Hùng really expect me to dive into the ocean in trunks and froth all over my mouth? Fuck that! We go in and go out, together!"
    }
   ]
  },
