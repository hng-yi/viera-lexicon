  {
   "headword": "giặc lái",
   "base": "108ebf54fe775346",
   "senses": [
    {
     "position": 1,
     "pos": "noun",
     "tags": [
      "derogatory",
      "historical"
     ],
     "gloss": "American and allies' pilots who partook in the bombing of Indochina during the Vietnam War"
    },
    {
     "position": 2,
     "pos": "noun",
     "tags": [
      "colloquial"
     ],
     "gloss": "wild driver; person who drives like crazy"
    }
   ],
   "examples": [
    {
     "sense": 1,
     "vi": "Những năm kháng chiến chống Mỹ, quân và dân Quảng Bình đã đồng sức, đồng lòng, bắn rơi 704 máy bay, tiêu diệt và bắt sống 119 tên giặc lái, biệt kích Mỹ.",
     "en": "During the years of Resistance War against America, soldiers and people of Quảng Bình have, together in unison, taken down 704 aircrafts, destroyed and captured alive 119 American enemy pilots and commandos."
    },
    {
     "sense": 2,
     "vi": "Lái xe đã sợ, người ngồi bên cạnh lại càng sợ hơn, đặc biệt khi mà tính mạng mình nằm trong tay \"giặc lái\"…",
     "en": "When the driving is scary, it is even more so for the person sitting next to the driver, especially when their life is in the hands of a wild driver…"
    }
   ]
  },
  {
   "headword": "giặt gỵa",
   "base": "989b9c74608fb118",
   "senses": [
    {
     "position": 1,
     "pos": "verb",
     "tags": [],
     "gloss": "to do the laundry"
    }
   ],
   "examples": [
    {
     "sense": 1,
     "vi": "Ban đầu Bốn Thôi lui tới mỗi ngày vài lượt, về sau anh ta phải ở lại nhà mẹ vợ suốt nửa tháng để chăm nom thuốc thang, nấu cơm, giặt gỵa cho bà ta.",
     "en": null
    },
    {
     "sense": 1,
     "vi": "Nàng định bụng rằng có ngày sẽ tảo thanh màu đen vì mặc áo trắng, chúng nó bắt buộc phải giặt gỵa thường, không làm sao mà cầm mồ hôi lâu ngày trong đó được.",
     "en": null
    },
    {
     "sense": 1,
     "vi": "Trọn ngày hôm nay, hai chị em quét tước lau chùi nhà cửa rồi giặt gỵa phơi phóng rèm màn cùng mùng mền, áo gối.",
     "en": "All day today, the two sisters swept and mopped the house, then washed and dried the blinds as well as the mosquito nets and pillow cases."
    }
