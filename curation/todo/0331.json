   "base": "91db527a952851d2",
   "senses": [
    {
     "position": 1,
     "pos": "prep",
     "tags": [],
     "gloss": "connects two ideas, or two syllables of a word for one idea, and emphasizes that that idea or those ideas have no bearing on the current situation, and therefore that idea or those ideas are to be dismissed out of hand"
    }
   ],
   "examples": [
    {
     "sense": 1,
     "vi": "Con với chẳng cái, có giúp được mẹ tí gì đâu !",
     "en": "Why the hell did I even give birth to you? You're no use to me whatsoever!"
    },
    {
     "sense": 1,
     "vi": "Quà với chẳng cáp ! Anh em mình với nhau mà !",
     "en": "Why'd you bother buying me gifts? We're bosom buddies!"
    },
    {
     "sense": 1,
     "vi": "Nhưng ta chẳng cần con mẹ nó gì danh môn với chẳng danh môn, chính phái với chẳng chính phái, miễn sao sử cho đúng cách.",
     "en": "I don’t give a damn about his background or sect, just how I can make good use of him."
    },
    {
     "sense": 1,
     "vi": "Làm gì có đông với chẳng tây. Mặt trời mọc lên ở đằng đông, lặn xuống ở đằng tây, nhưng đó đơn thuần chỉ là một quan sát thiên văn. Biết rằng ta chẳng hiểu đông là gì, tây là gì thì gần với sự thật hơn. Thực tế thì không ai biết mặt trời từ đâu mà ra.",
     "en": "There ain't no east or west. The sun rises in the east and sets in the west for sure, but that's just an astronomical observation. It's more accurate to say we don't actually know what east and west mean. The fact of the matter is nobody really knows where the sun comes from."
    },
    {
     "sense": 1,
     "vi": "“[…] Thuyền với chẳng thiếc. Tôi chẳng hiểu nổi. Anh bị làm sao vậy?”",
     "en": "“[…] To hell with boats. I just don’t get it. What’s wrong with you?”"
    }
   ]
