   "headword": "đế quốc Mĩ",
   "base": "b9fa4a82d4400ad0",
   "senses": [
    {
     "position": 1,
     "pos": "noun",
     "tags": [
      "collective",
      "historical"
     ],
     "gloss": "American imperialists, a term for Americans during the Vietnam War, often used comparatively with thực dân Pháp (“French colonialists”), and sometimes also with phát xít Nhật (“Japanese fascists”)"
    }
   ],
   "examples": []
  },
  {
